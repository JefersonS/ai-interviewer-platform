# Required. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Any OpenRouter model id that supports JSON output.
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Optional. Public-deploy protection (only enforced when NODE_ENV=production).
# Model calls allowed per IP every 15 minutes, and in total per hour.
RATE_LIMIT_PER_IP=60
RATE_LIMIT_GLOBAL_PER_HOUR=600

# Optional. Postgres connection string; turns on the saved history (history, replay, analytics).
# Without it: in-memory history in development, and "not configured" in production.
DATABASE_URL=
RATE_LIMIT_HISTORY_PER_IP=120
